{
  // Instellingen voor Cloudflare Workers
  "name": "rt-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // KV-opslag 'rt-bookings' (agenda)
    { "binding": "BOOKINGS", "id": "18c6d28367d04d5f82e933189cd573c1" }
  ]
}
